# TRACE-X Environment Configuration

# General
NODE_ENV=development
PORT=5000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tracex
POSTGRES_PASSWORD=tracex_secret
POSTGRES_DB=tracex_db
DATABASE_URL="postgresql://tracex:tracex_secret@localhost:5433/tracex_db?schema=public"

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracex_secret
NEO4J_AUTH=neo4j/tracex_secret
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# AI Service
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
JWT_SECRET=super_secret_tracex_jwt_key_sih_2026
JWT_EXPIRES_IN=24h
